{
  "name": "mssql-readonly-mcp",
  "version": "1.0.0",
  "description": "Read-only SQL Server MCP server with SELECT-only guard, row limit, timeout and audit log. Ships with a fictional HR demo database.",
  "license": "MIT",
  "author": "Rifaldi Radya Pratama (https://rifaldiradya.com)",
  "type": "module",
  "bin": {
    "mssql-readonly-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/guard.test.js",
    "test:db": "tsc && node --env-file=.env --test dist/db.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mssql": "^12.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
